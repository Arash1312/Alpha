## نمونه فایل اصلی پروژه: `agent.py`

```python
from datetime import datetime


class Agent:

    def __init__(self, name, goal):
        self.name = name
        self.goal = goal
        self.memory = []

    def remember(self, data):
        self.memory.append({
            "timestamp": datetime.utcnow(),
            "data": data
        })

    def analyze(self, task):
        result = {
            "agent": self.name,
            "task": task,
            "status": "completed",
            "timestamp": datetime.utcnow().isoformat()
        }

        self.remember(result)

        return result


if __name__ == "__main__":

    agent = Agent(
        name="NexusAgent",
        goal="Autonomous research"
    )

    output = agent.analyze(
        "Analyze decentralized AI infrastructure"
    )

    print(output)
